// Merge into ~/.openclaw/openclaw.json via:
//   openclaw config patch --file path\to\aquamind.patch.json5
// WhatsApp allowlist + group admission: run scripts\patch-whatsapp-allowlist.ps1 (also reads WHATSAPP_SELF_E164 from .env).
//
// Model order aligns with WaterSec FastAPI heuristic tiers (balanced → heavy → fast fallbacks):
//   primary Qwen (balanced telemetry), then MiniMax (heavy / codegen), then LFM (cheap last resort).
// OpenClaw cannot vary primary per message from JSON alone; this chain approximates WhatsApp routing.

{
  plugins: {
    allow: ["whatsapp", "openrouter", "memory-core"],
  },
  agents: {
    defaults: {
      timeoutSeconds: 180,
      params: {
        extra_body: {
          provider: {
            sort: "latency",
          },
        },
      },
      model: {
        primary: "openrouter/qwen/qwen3-next-80b-a3b-instruct:free",
        fallbacks: [
          "openrouter/minimax/minimax-m2.5:free",
          "openrouter/liquid/lfm-2.5-1.2b-instruct:free",
        ],
        timeoutMs: 120000,
      },
      models: {
        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free": {},
        "openrouter/minimax/minimax-m2.5:free": {},
        "openrouter/liquid/lfm-2.5-1.2b-instruct:free": {},
      },
      thinkingDefault: "minimal",
    },
    list: [
      {
        id: "main",
        default: true,
        fastModeDefault: true,
      },
    ],
  },
  messages: {
    groupChat: {
      mentionPatterns: ["@clanker\\b"],
      historyLimit: 50,
    },
  },
}
