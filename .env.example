# Copy to `.env` for local config (never commit `.env` or `env`).
# The backend and start scripts also load `env` (no dot) if present; values in `env` override `.env` for duplicate keys.

DAYTONA_API_KEY=
# Optional
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us|eu|...

OPENROUTER_API_KEY=

# Per-role OpenRouter model slugs (free tier defaults; see https://openrouter.ai/models)
# Qwen (planner): fast but lower uptime → automatic fallback to AQUAMIND_MODEL_PLANNER_FALLBACK.
# MiniMax (code/Daytona): heavier, more reliable codegen.
# LFM (chat): small/fast when you wire conversational mode to role=chat.
# Legacy: set AQUAMIND_OPENROUTER_MODEL to force the same slug as primary for all unset roles.

# AQUAMIND_MODEL_CHAT=liquid/lfm-2.5-1.2b-instruct:free
# AQUAMIND_MODEL_CHAT_FALLBACK=minimax/minimax-m2.5:free

# AQUAMIND_MODEL_PLANNER=qwen/qwen3-next-80b-a3b-instruct:free
# AQUAMIND_MODEL_PLANNER_FALLBACK=minimax/minimax-m2.5:free

# AQUAMIND_MODEL_CODE=minimax/minimax-m2.5:free
# AQUAMIND_MODEL_CODE_FALLBACK=qwen/qwen3-next-80b-a3b-instruct:free

# AQUAMIND_OPENROUTER_MAX_RETRIES=5
# AQUAMIND_OPENROUTER_RETRY_BASE_SEC=2.5

# Heuristic routing (no LLM): regex intent + prompt length → tier fast|balanced|heavy.
# AQUAMIND_ROUTING_HEAVY_CHARS=800
# AQUAMIND_ROUTING_HEAVY_LINES=20
# Your WhatsApp number in E.164 (required for allowlist with friends below)
WHATSAPP_SELF_E164=

# Gmail report sender for AquaMind incident emails.
# OAuth client_secret.json and token.json should live outside the repo.
GMAIL_SENDER=
GMAIL_TO=
# Optional comma-separated CC list
# GMAIL_CC=
# GMAIL_CLIENT_SECRET_FILE=%USERPROFILE%\.openclaw\gmail\client_secret.json
# GMAIL_TOKEN_FILE=%USERPROFILE%\.openclaw\gmail\token.json
# GMAIL_DB_PATH=%USERPROFILE%\.openclaw\gmail\gmail_reports.sqlite3

# Optional: FastAPI analytics over telemetry SQLite (see scripts/start-aquamind-backend.ps1)
# AQUAMIND_DB_PATH=
# AQUAMIND_API_BASE=http://127.0.0.1:8765
# Comma-separated browser origins for Vite + POST /run (default includes :5173–:5174, :3000, :4173).
# AQUAMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use * only for quick tests (cookies not sent cross-origin with *).
# AQUAMIND_CORS_ORIGINS=*

# Dashboard POST /run: try real SQLite tool plan first (default true). Set false to always use Daytona Python.
# AQUAMIND_CHAT_SQLITE_FIRST=true
